# -----------------------------------------------------------------------------
# Striking Camp - Variables d'environnement
# Copiez ce fichier en .env.local et renseignez vos valeurs.
# Ne jamais committer .env.local (déjà dans .gitignore).
# -----------------------------------------------------------------------------

# Supabase - URL publique du projet
NEXT_PUBLIC_SUPABASE_URL=

# Supabase - Clé publishable (anon key, sûre côté client)
# Ne jamais utiliser la service_role key ici
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase - Clé secrète d'administration (service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Resend - Envoi d'emails transactionnels (API key disponible sur https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Striking Camp <onboarding@resend.dev>
CONTACT_RECIPIENT_EMAIL=strikingcamp13@gmail.com

# Google Analytics 4 (optionnel - désactivé si vide)
# Format : G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Web Push - Clés VAPID (Voluntary Application Server Identification)
# Générez une paire avec : node scripts/generate-vapid-keys.mjs
# Clé publique VAPID (exposée côté client pour l'abonnement navigateur)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Clé privée VAPID (STRICTEMENT côté serveur pour signer les notifications)
VAPID_PRIVATE_KEY=
# Contact du responsable du push (mailto:contact@strikingcamp.fr ou URL)
VAPID_SUBJECT=mailto:contact@strikingcamp.fr

# Cron & Scheduler de rappels
# Secret d'authentification Bearer pour les routes /api/cron/* (Vercel Cron & Supabase Edge)
CRON_SECRET=
# Bascule Dry-Run : 'true' en développement/staging (simulation sans push), 'false' en production pour dispatch réel
REMINDER_DISPATCH_DRY_RUN=true
